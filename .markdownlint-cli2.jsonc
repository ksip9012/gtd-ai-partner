// markdownlint の設定。日本語の文書と、このリポジトリの書き方に合わないルールだけを外す
{
  "config": {
    "default": true,
    // 箇条書きのインデントはスペース2個（番号つきの箇条の下は、番号の幅に合わせて 3個）
    "MD007": { "indent": 2 },
    // 日本語の文は 1行が長くなるので、行の長さは見ない
    "MD013": false,
    // ワークスペースのノートは frontmatter から始まり、1行目が見出しとは限らない
    "MD041": false,
    // 表の列の幅をそろえるルール。全角の文字があるとそろえられない
    "MD060": false
  },
  "ignores": ["**/.obsidian/**"]
}
